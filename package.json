{
  "name": "amazingakai-hugo-blog",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint:md": "markdownlint-cli2 \"content/**/*.md\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.4",
    "lint-staged": "^15.2.9",
    "markdownlint-cli2": "^0.14.0",
    "prettier": "^3.3.3",
    "prettier-plugin-go-template": "^0.0.15"
  },
  "lint-staged": {
    "*.{js,css,json,toml,yaml,yml,html}": "prettier --write",
    "*.md": [
      "prettier --write",
      "markdownlint-cli2 --fix"
    ]
  }
}
