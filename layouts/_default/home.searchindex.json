{{- $.Scratch.Add "searchindex" slice -}}
{{- range $index, $element := where site.RegularPages "Params.sitemap.disable" "ne" true -}}
    {{- $.Scratch.Add "searchindex" (dict "id" $index "title" $element.Title "permalink" $element.RelPermalink "tags" (delimit ($element.Params.tags | default "") " ") "content" $element.Plain "summary" (partial "components/summary.html" $element) "date" ($element.Date.Format ($.Param "dateformat" | default "2 January, 2006")) "banner" ($element.Params.banner | default "")) -}}
{{- end -}}
{{- $.Scratch.Get "searchindex" | jsonify -}}
